{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Flutter web server",
			"type": "shell",
			"command": "flutter",
			"args": [
				"run",
				"-d",
				"web-server",
				"--web-hostname",
				"127.0.0.1",
				"--web-port",
				"8080"
			],
			"isBackground": true,
			"problemMatcher": [
				"$flutter"
			],
			"group": "build"
		}
	]
}